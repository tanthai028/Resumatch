{
  "manifest_version": 3,
  "name": "Resume Matcher",
  "version": "0.1.0",
  "description": "Picks which of your resumes fits a job posting, flags dealbreakers, and logs applications. Runs fully offline.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "alarms"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Match this job to a resume",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
